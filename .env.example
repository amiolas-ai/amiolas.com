# Public site URL (used for absolute URLs in metadata, OG, sitemap)
# Production: https://amiolas.com
# Preview/dev: leave unset; defaults handled by code
NEXT_PUBLIC_SITE_URL=https://amiolas.com

# --- Slack (Contact widget ↔ Slack bridge) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_INBOX_CHANNEL_ID=C0...

# --- Vercel KV / Upstash Redis ---
# Auto-injected by `vercel env pull` after connecting Storage to project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
